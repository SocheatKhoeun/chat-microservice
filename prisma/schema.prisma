generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model settings {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  hash        String   @db.VarChar(255) // unique hash for the setting
  key         String   @unique @db.VarChar(255) // config key, e.g. "payment_type", "api_base_url"
  value       String   @db.VarChar(255) // config value, e.g. "bakong", "https://..."
  description String?  @db.VarChar(255) // optional description of the setting
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@map("settings")
}

model oauth_clients {
  id            Int      @id @default(autoincrement())
  client_id     String   @unique
  client_secret String
  grant_type_id Int
  is_disabled   Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  grant_type oauth_client_grant_types @relation(fields: [grant_type_id], references: [id])
  users      users[]

  @@map("oauth_clients")
}

model oauth_client_grant_types {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  oauth_clients oauth_clients[]

  @@map("oauth_client_grant_types")
}

model users {
  id              String    @id @db.VarChar(255)
  oauth_client_id Int?
  last_seen_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  oauth_client          oauth_clients?         @relation(fields: [oauth_client_id], references: [id])
  created_conversations conversations[]
  conversation_members  conversation_members[]
  sent_messages         messages[]             @relation("MessageSender")
  pinned_messages       messages[]             @relation("MessagePinner")
  message_reactions     message_reactions[]
  message_reads         message_reads[]
  message_deliveries    message_deliveries[]
  calls                 calls[]
  call_participants     call_participants[]

  // Users this account has blocked, and users who have blocked this account.
  blocking   blocked_users[] @relation("BlockerRelation")
  blocked_by blocked_users[] @relation("BlockedRelation")

  @@map("users")
}

model conversations {
  id          Int                @id @default(autoincrement())
  hash        String             @unique
  type        conversation_type?
  name        String?            @db.VarChar(255)
  description String?            @db.VarChar(255)
  avatar_url  String?            @db.VarChar(255)
  created_by  String?            @db.VarChar(255)
  direct_key  String?            @unique @db.VarChar(255)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  creator  users?                 @relation(fields: [created_by], references: [id])
  members  conversation_members[]
  messages messages[]
  calls    calls[]

  @@map("conversations")
}

model conversation_members {
  id              Int                       @id @default(autoincrement())
  conversation_id Int
  user_id         String                    @db.VarChar(255)
  nickname        String?                   @db.VarChar(255)
  role            conversation_member_role?
  joined_at       DateTime                  @default(now())
  left_at         DateTime?

  is_muted    Boolean   @default(false)
  is_archived Boolean   @default(false)
  is_pinned   Boolean   @default(false)
  pinned_at   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         users         @relation(fields: [user_id], references: [id])

  @@unique([conversation_id, user_id])
  @@index([user_id, is_archived, left_at, is_pinned, conversation_id])
  @@map("conversation_members")
}

model messages {
  id                 Int           @id @default(autoincrement())
  hash               String?       @unique
  conversation_id    Int
  sender_id          String        @db.VarChar(255)
  type               message_type?
  content            String?       @db.Text
  replied_message_id Int?
  edited_at          DateTime?
  deleted_at         DateTime?

  is_pinned          Boolean       @default(false)
  pinned_at          DateTime?
  pinned_by          String?       @db.VarChar(255)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  conversation    conversations         @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender          users                 @relation("MessageSender", fields: [sender_id], references: [id])
  pinner          users?                @relation("MessagePinner", fields: [pinned_by], references: [id])
  replied_message messages?             @relation("MessageReplies", fields: [replied_message_id], references: [id])
  replies         messages[]            @relation("MessageReplies")
  reactions       message_reactions[]
  reads           message_reads[]
  deliveries      message_deliveries[]
  attachments     message_attachments[]

  @@index([conversation_id, id])
  @@map("messages")
}

model message_reactions {
  id         Int      @id @default(autoincrement())
  hash       String?  @unique
  message_id Int
  user_id    String   @db.VarChar(255)
  reaction   String   @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  message messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    users    @relation(fields: [user_id], references: [id])

  @@unique([message_id, user_id])
  @@map("message_reactions")
}

model message_reads {
  id         Int      @id @default(autoincrement())
  message_id Int
  user_id    String   @db.VarChar(255)
  read_at    DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  message messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    users    @relation(fields: [user_id], references: [id])

  @@unique([message_id, user_id])
  @@map("message_reads")
}

model message_deliveries {
  id           Int      @id @default(autoincrement())
  message_id   Int
  user_id      String   @db.VarChar(255)
  delivered_at DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  message messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    users    @relation(fields: [user_id], references: [id])

  // One delivery record per user per message — mirrors message_reactions'
  // race-free upsert pattern rather than message_reads' known duplicate-row gap.
  @@unique([message_id, user_id])
  @@map("message_deliveries")
}

model message_attachments {
  id         Int    @id @default(autoincrement())
  message_id Int
  file_url   String @db.VarChar(255)
  file_type  String @db.VarChar(255)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  message messages @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model blocked_users {
  id         Int      @id @default(autoincrement())
  blocker_id String   @db.VarChar(255)
  blocked_id String   @db.VarChar(255)
  created_at DateTime @default(now())

  blocker users @relation("BlockerRelation", fields: [blocker_id], references: [id])
  blocked users @relation("BlockedRelation", fields: [blocked_id], references: [id])

  // A user can only block another user once — re-blocking is a no-op (upsert).
  @@unique([blocker_id, blocked_id])
  @@map("blocked_users")
}

model calls {
  id              Int          @id @default(autoincrement())
  hash            String?      @unique
  conversation_id Int
  caller_id       String       @db.VarChar(255)
  type            call_type?
  status          call_status?
  started_at      DateTime?
  answered_at     DateTime?
  ended_at        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  conversation conversations       @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  caller       users               @relation(fields: [caller_id], references: [id])
  participants call_participants[]

  @@map("calls")
}

model call_participants {
  id        Int                      @id @default(autoincrement())
  call_id   Int
  user_id   String                   @db.VarChar(255)
  joined_at DateTime                 @default(now())
  left_at   DateTime?
  status    call_participant_status?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  call calls @relation(fields: [call_id], references: [id], onDelete: Cascade)
  user users @relation(fields: [user_id], references: [id])

  @@map("call_participants")
}

enum conversation_type {
  direct
  group
}

enum conversation_member_role {
  owner
  admin
  member
}

enum message_type {
  text
  image
  video
  audio
  file
  system
}

enum attachment_type {
  image
  video
  audio
  file
}

enum call_type {
  audio
  video
}

enum call_status {
  ringing
  active
  ended
  missed
  rejected
  cancelled
}

enum call_participant_status {
  invited
  ringing
  joined
  left
  rejected
  missed
}
