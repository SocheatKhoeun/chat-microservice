generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model settings {
  id                        Int                    @id @default(autoincrement()) @db.UnsignedInt
  hash                      String                 @db.VarChar(255) // unique hash for the setting
  key                       String                 @unique @db.VarChar(255) // config key, e.g. "payment_type", "api_base_url"
  value                     String                 @db.VarChar(255) // config value, e.g. "bakong", "https://..."
  description               String?                @db.VarChar(255) // optional description of the setting
  created_at                DateTime               @default(now()) @db.Timestamp(0)
  updated_at                DateTime               @default(now()) @updatedAt @db.Timestamp(0)

  @@map("settings")
}

model oauth_clients {
  id                 Int      @id @default(autoincrement())
  client_id          String   @unique
  client_secret      String
  grant_type_id      Int
  is_disabled        Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  conversations conversations[]

  @@map("oauth_clients")
}

model conversations {
  id                       Int       @id @default(autoincrement())
  // owning integration (the calling project), so data from different
  // consumers of this microservice never mixes
  client_id                Int
  // external user ids, owned by the calling project — always stored with
  // participant_one_id < participant_two_id so a pair only ever maps to
  // one conversation regardless of call order
  participant_one_id       String    @db.VarChar(191)
  participant_two_id       String    @db.VarChar(191)
  participant_one_read_at  DateTime? @db.Timestamp(0)
  participant_two_read_at  DateTime? @db.Timestamp(0)
  last_message_at          DateTime? @db.Timestamp(0)
  created_at               DateTime  @default(now()) @db.Timestamp(0)
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamp(0)

  client   oauth_clients @relation(fields: [client_id], references: [id])
  messages messages[]

  @@unique([client_id, participant_one_id, participant_two_id])
  @@index([client_id, participant_one_id])
  @@index([client_id, participant_two_id])
  @@map("conversations")
}

model messages {
  id              Int      @id @default(autoincrement())
  conversation_id Int
  // external user id of whoever sent the message
  sender_id       String   @db.VarChar(191)
  body            String   @db.Text
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(0)

  conversation conversations @relation(fields: [conversation_id], references: [id])

  @@index([conversation_id, created_at])
  @@map("messages")
}

model oauth_client_grant_types {
  id          Int      @id @default(autoincrement())
  username    String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("oauth_client_grant_types")
}