# Copy to .env and fill in real values. .env is gitignored and excluded from
# the Docker build context (.dockerignore) — it's never baked into the image.
# On a deploy target (dev/prod server), this same file (or equivalent
# environment variables) must be supplied to the running container, e.g. via
# `docker compose --env-file .env up` (see docker-compose.yml).

NODE_ENV=development
PORT=3000

# mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://user:password@localhost:3306/chat_microservice"

# Comma-separated list of allowed origins for CORS.
ALLOW_CORS=http://localhost:5000

# S3/MinIO — used by StorageService for message attachment uploads.
S3_ENDPOINT=
S3_PORT=443
S3_USE_SSL=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
